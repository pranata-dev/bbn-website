# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional Email (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_SENDER_ADDRESS=contact@example.com
EMAIL_SENDER_NAME="Belajar Bareng Nata"

# Payment Details (required in runtime environments that accept manual transfers)
NEXT_PUBLIC_PAYMENT_BANK_NAME=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=""
NEXT_PUBLIC_PAYMENT_ACCOUNT_HOLDER=""
NEXT_PUBLIC_GOPAY_NUMBER=""
NEXT_PUBLIC_GOPAY_NAME=""

# Contacts
NEXT_PUBLIC_ADMIN_WHATSAPP=""

# Optional Zoom masterclass links and schedules (JSON strings)
# ZOOM_LINKS_JSON='{"FISMAT":"https://zoom.us/j/...","FISDAS2":"https://zoom.us/j/..."}'
# ZOOM_SCHEDULES_JSON='{"FISMAT":"Sabtu, 10 Mei 2026 pukul 19:00 WIB","FISDAS2":"Minggu, 11 Mei 2026 pukul 19:00 WIB"}'

# Excellent Beta (High School Physics SAS Mode) - Server-only class passwords
# Do NOT expose these with NEXT_PUBLIC_
EXCELLENT_PASSWORD_X=replace_with_grade_x_password
EXCELLENT_PASSWORD_XI=replace_with_grade_xi_password
EXCELLENT_PASSWORD_XII=replace_with_grade_xii_password
